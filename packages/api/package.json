{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@universalbookmarks/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format": "oxfmt --ignore-path=../../.gitignore --check .",
    "format:fix": "oxfmt --ignore-path=../../.gitignore .",
    "lint": "oxlint --ignore-path=../../.gitignore .",
    "lint:fix": "oxlint --ignore-path=../../.gitignore . --fix",
    "test": "vitest"
  },
  "dependencies": {
    "@hono/otel": "^1.1.1",
